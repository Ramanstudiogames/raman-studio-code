<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- The Game Surface View -->
    <com.ramanstudio.games.BrickBreakerView
        android:id="@+id/brickBreakerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E1E1E"
            android:text="← Menu"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Brick Breaker"
            android:textColor="#FFC107"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#1E1E1E"
            android:text="⚙ Setup"
            android:textColor="#FFC107"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRestart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#1E1E1E"
            android:text="↺ New"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Pre-Game Setup Overlay Screen -->
    <LinearLayout
        android:id="@+id/layoutSetup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="24dp"
        android:background="#1E1E1E"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GAME SETUP"
            android:textColor="#FFC107"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Select Difficulty Mode:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Difficulty Selection Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEasy"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:backgroundTint="#FFC107"
                android:padding="0dp"
                android:text="Easy"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnMedium"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A2A"
                android:padding="0dp"
                android:text="Medium"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHard"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A2A"
                android:padding="0dp"
                android:text="Hard"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExtreme"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:backgroundTint="#2A2A2A"
                android:padding="0dp"
                android:text="Extreme"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnStartGame"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#FFC107"
            android:text="▶ START GAME"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
